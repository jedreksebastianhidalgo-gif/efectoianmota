<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Variedades de Cannabis</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {

            min-height: 100vh;

            background:
                radial-gradient(
                    circle at top,
                    #174d2d,
                    #071b11 45%,
                    #020806 100%
                );

            color: white;

            padding: 50px 20px;

        }


        /* =========================
           ENCABEZADO
        ========================= */

        .titulo {

            text-align: center;

            margin-bottom: 50px;

        }

        .titulo h1 {

            font-size: 48px;

            color: #68ff91;

            text-shadow:
                0 0 10px #29c957,
                0 0 25px rgba(41,201,87,.5);

            margin-bottom: 12px;

        }

        .titulo h2 {

            font-size: 20px;

            color: #d5e9dc;

            font-weight: normal;

            margin-bottom: 12px;

        }

        .titulo p {

            max-width: 700px;

            margin: auto;

            color: #91ad9c;

            line-height: 1.6;

        }


        /* =========================
           TARJETAS
        ========================= */

        .contenedor-tarjetas {

            width: 100%;

            max-width: 1050px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(3, 300px);

            justify-content: center;

            gap: 35px;

        }


        .tarjeta {

            width: 300px;

            height: 350px;

            perspective: 1000px;

        }


        .cara {

            position: relative;

            width: 100%;

            height: 100%;

            border-radius: 20px;

            overflow: hidden;

            backface-visibility: hidden;

            transition: transform .7s ease;

        }


        /* =========================
           FRENTE
        ========================= */

        .frontal {

            position: absolute;

            transform: rotateY(0deg);

            background:
                linear-gradient(
                    145deg,
                    #123d25,
                    #020b06
                );

            border:
                1px solid #2b7546;

            box-shadow:
                0 12px 30px rgba(0,0,0,.7);

        }


        .frontal img {

            width: 100%;

            height: 100%;

            object-fit: cover;

            display: block;

        }


        /* Oscurecer parte inferior */

        .frontal::after {

            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    transparent 45%,
                    rgba(0,0,0,.95)
                );

        }


        .frontal h3 {

            position: absolute;

            bottom: 20px;

            left: 0;

            width: 100%;

            text-align: center;

            z-index: 2;

            font-size: 25px;

            text-shadow:
                2px 2px 6px black;

        }


        /* =========================
           PARTE TRASERA
        ========================= */

        .posterior {

            position: absolute;

            transform: rotateY(180deg);

            background:
                linear-gradient(
                    145deg,
                    #123d25,
                    #041009
                );

            border:
                1px solid #347d4e;

            padding: 25px;

            display: flex;

            flex-direction: column;

            justify-content: space-between;

            text-align: center;

            box-shadow:
                0 12px 30px rgba(0,0,0,.7);

        }


        .posterior h3 {

            color: #68ff91;

            font-size: 26px;

        }


        .posterior p {

            color: #d2dfd6;

            font-size: 14px;

            line-height: 1.6;

        }


        .info {

            background:
                rgba(0,0,0,.35);

            border:
                1px solid #28653c;

            padding: 12px;

            border-radius: 10px;

            color: #8affaa;

        }


        .info span {

            color: white;

            font-weight: bold;

        }


        .link {

            border-top:
                1px solid #347d4e;

            padding-top: 15px;

        }


        .link a {

            color: #68ff91;

            text-decoration: none;

            font-weight: bold;

        }


        .link a:hover {

            color: white;

        }


        /* =========================
           ANIMACIÓN
        ========================= */

        .tarjeta:hover .frontal {

            transform:
                rotateY(-180deg);

        }


        .tarjeta:hover .posterior {

            transform:
                rotateY(0deg);

        }


        /* =========================
           PIE
        ========================= */

        footer {

            text-align: center;

            margin-top: 60px;

            color: #668573;

            font-size: 13px;

        }


        /* =========================
           TABLET
        ========================= */

        @media (max-width: 1000px) {

            .contenedor-tarjetas {

                grid-template-columns:
                    repeat(2, 300px);

            }

        }


        /* =========================
           CELULAR
        ========================= */

        @media (max-width: 680px) {

            .titulo h1 {

                font-size: 34px;

            }

            .titulo h2 {

                font-size: 17px;

            }

            .contenedor-tarjetas {

                grid-template-columns: 1fr;

            }

            .tarjeta {

                margin: auto;

            }

        }

    </style>

</head>


<body>


    <!-- =========================
         TÍTULO
    ========================= -->

    <div class="titulo">

        <h1>🌿 Variedades de Cannabis</h1>

        <h2>
